# Template for the Zenodo mirror. Make one copy per Zenodo instance in this
# folder, named after its host, and fill in the token:
#   .env.sandbox.zenodo.org  (Zenodo sandbox, test data)
#   .env.zenodo.org          (Zenodo production, public and permanent)
# Those copies are git-ignored; this template is not.

# Supabase project whose public buckets are copied. Not secret; no key needed.
SUPABASE_URL=https://<project-ref>.supabase.co

# Zenodo instance: https://sandbox.zenodo.org or https://zenodo.org
ZENODO_URL=https://sandbox.zenodo.org

# Personal access token of that Zenodo instance,
# scopes deposit:write and deposit:actions.
ZENODO_TOKEN=

# Optional: slug of the Zenodo community the Zenodo records go into.
ZENODO_COMMUNITY=sports-athletic
