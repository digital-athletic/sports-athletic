# Copy to .env and adjust. All EXPO_PUBLIC_* values are inlined into the JS
# bundle at build time, so they are readable in the shipped app. Never put a
# service key or any other secret here; the Supabase anon key is public by
# design and access is enforced by row level security.

# Required. The app throws on startup when either is missing.
# `supabase start` prints both values. For the Android emulator, keep localhost
# and run `adb reverse tcp:54321 tcp:54321`.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sync of workouts, exercise data and strength tests. "false" disables it.
EXPO_PUBLIC_SERVER_SYNC_ENABLED=true

# Transmits activity counts only, no weights or repetitions.
EXPO_PUBLIC_SERVER_SYNC_ACTIVITY_ONLY_ENABLED=true

# Requires analytics consent and shows the option during registration.
EXPO_PUBLIC_ANALYTICS_CONSENT_ENABLED=true

# Legal links. An empty value hides the matching entry in the profile menu.
# LINK_PRIVACY does more than that: it also decides whether privacy consent is
# required at all, so emptying it switches off that part of the consent gate.
# LINK_AGB only changes the wording of the privacy label.
EXPO_PUBLIC_LINK_AGB=
EXPO_PUBLIC_LINK_PRIVACY=
EXPO_PUBLIC_LINK_IMPRINT=

# Online form links at the top of the lower profile menu part. An empty value
# hides the matching entry.
EXPO_PUBLIC_LINK_CONSENT_U16=
EXPO_PUBLIC_LINK_FEEDBACK_REPORT=
EXPO_PUBLIC_LINK_SURVEY=

# Trainer access button in the team management. An empty value hides it.
EXPO_PUBLIC_LINK_TRAINER_AREA=

# Links at the top of the introduction videos. An empty value hides the
# matching entry.
EXPO_PUBLIC_LINK_INTRO_VIDEOS_TRAINERS=
EXPO_PUBLIC_LINK_INTRO_VIDEOS_PLAYERS=

# Shows the contact entry in the profile menu.
EXPO_PUBLIC_CONTACT_ENABLED=false

# App store review bypass. Leave unset for normal development.
# EXPO_PUBLIC_REVIEW_EMAIL=reviewer@example.com
# EXPO_PUBLIC_REVIEW_OTP=123456
