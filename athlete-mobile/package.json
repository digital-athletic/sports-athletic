{
  "name": "athlete-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "expo prebuild --clean",
    "clean:build": "rm -rf android && rm -rf ios",
    "lint": "expo lint --max-warnings 0",
    "format-check": "prettier . --check",
    "format-fix": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "expo-router-generate-types": "expo customize tsconfig.json",
    "build:device-dev-client": "pnpm run clean:build && pnpm dlx eas-cli@latest build --profile development",
    "build:simulator-dev-client": "pnpm run clean:build && pnpm dlx eas-cli@latest build --profile development-simulator",
    "build:preview": "pnpm run clean:build && pnpm dlx eas-cli@latest build --profile preview",
    "build:production": "pnpm run clean:build && pnpm dlx eas-cli@latest build --profile production",
    "submit:preview": "pnpm run clean:build && pnpm dlx eas-cli@latest build --profile preview --auto-submit",
    "update:preview": "pnpm run clean:build && pnpm dlx eas-cli@latest update --channel preview --environment preview",
    "update:production": "pnpm run clean:build && pnpm dlx eas-cli@latest update --channel production --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@shopify/restyle": "2.4.5",
    "@supabase/supabase-js": "^2.86.0",
    "expo": "~54.0.31",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-router": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.15",
    "expo-video": "~3.0.15",
    "i18next": "25.6.2",
    "immer": "^10.2.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "16.3.2",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "valibot": "^1.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "9.39.2",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "~10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.16",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.25.0"
}
