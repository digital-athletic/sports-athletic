{
  "name": "athlete-mobile",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:docker": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "expo prebuild --clean",
    "clean:build": "rm -rf android && rm -rf ios",
    "lint": "expo lint --max-warnings 0",
    "lint:prune-suppressions": "eslint . --prune-suppressions",
    "format-check": "prettier . --check",
    "format-fix": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "e2e:static": "expo export --platform web && node scripts/serve-e2e-static.mjs dist",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "generate:notice": "node scripts/generate-notice.mjs",
    "prepare:build": "pnpm generate:notice && pnpm clean:build",
    "expo-router-generate-types": "expo customize tsconfig.json",
    "build:device-dev-client": "pnpm prepare:build && pnpm dlx eas-cli@latest build --profile development",
    "build:simulator-dev-client": "pnpm prepare:build && pnpm dlx eas-cli@latest build --profile development-simulator",
    "build:preview": "pnpm prepare:build && pnpm dlx eas-cli@latest build --profile preview",
    "build:production": "pnpm prepare:build && pnpm dlx eas-cli@latest build --profile production",
    "submit:preview": "pnpm prepare:build && pnpm dlx eas-cli@latest build --profile preview --auto-submit",
    "update:preview": " pnpm clean:build && pnpm dlx eas-cli@latest update --channel preview --environment preview",
    "update:production": "pnpm clean:build && pnpm dlx eas-cli@latest update --channel production --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@shopify/restyle": "2.4.5",
    "@supabase/supabase-js": "^2.86.0",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "i18next": "26.4.2",
    "immer": "^10.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gifted-charts": "^1.4.72",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1",
    "valibot": "^1.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "~19.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "9.39.2",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~3.10.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "knip": "6.1.1",
    "prettier": "3.6.2",
    "secretlint": "^11.4.1",
    "ts-prune": "0.10.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.15.0"
}
