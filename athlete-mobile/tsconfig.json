{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleSuffixes": [".android", ".ios", ".native", ".web", ""],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["legacy/**/*", "trainer-dashboard/**/*", "supabase/**/*"],
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
